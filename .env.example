# DATABASE_URL=postgres://user:pass@localhost:5432/omerta   # omit to use in-memory pg-mem
# JWT_SECRET=change-me-in-production
# PORT=8787
# MARKET_SEED=rotate-per-season-server-secret   # §7.11: keeps future price blocks unpredictable
# MOD_KEY=long-random-string                    # enables /v1/mod/* (X-Mod-Key header); unset = mod tools off
# SOCIAL_VERIFY_MODE=off                        # off | trust (alpha honor system) | live (real API checks)
# X_BEARER_TOKEN= X_TARGET_USER_ID=             # SOCIAL_VERIFY_MODE=live: X follow check
# DISCORD_BOT_TOKEN= DISCORD_GUILD_ID=          # SOCIAL_VERIFY_MODE=live: Discord member check
# SEARCH_MS / SHOOT_CD_MS / (never set in production — test-only §9 timer shrink)
# RATE_LIMIT=on                                 # §10.2; auto-on when NODE_ENV=production
# REDIS_URL=redis://localhost:6379              # shared rate-limit buckets across processes
# INVITE_MODE=on                                # closed alpha: new accounts need an invite code
# PRIVY_APP_ID=                                 # enables POST /v1/auth/privy
# INVARIANT_WEBHOOK_URL=                        # §10.4 drift alerts POST here (plus telemetry always)
# ── M6-B chain service (Robinhood Chain / EVM — NOT built yet; see omerta-chain-migration-evm.md) ──
# VOUCHER_SIGNER_PK=                            # server key that signs EIP-712 vouchers (viem)
# VOUCHER_CLAIM_ADDRESS=                        # deployed VoucherClaim contract
# CHAIN_ID=46630                                # Robinhood Chain testnet (mainnet 4663)
# CHAIN_RPC_URL=
