# OMERTÀ — environment variables. Copy to `.env` for local runs, or set these in your host's dashboard.
# The render.yaml Blueprint sets the REQUIRED ones for you automatically. This file documents them all.
# Full reference + rationale: DEPLOY.md (the game) and CHAIN-DEPLOY.md (mainnet).

# ── REQUIRED in production (the server REFUSES to boot without these) ──
NODE_ENV=production
DATABASE_URL=postgres://user:pass@host:5432/omerta   # a real Postgres. On Render this is auto-wired.
JWT_SECRET=change-me-to-a-long-random-string          # signs player login tokens
MARKET_SEED=change-me-24+chars-8+distinct-symbols     # secret seed for the price/number draws (§7.11)

# ── STRONGLY RECOMMENDED in production ──
SOCIAL_VERIFY_MODE=live      # REQUIRED for social/First-Week rewards to pay (anything else = they pay nothing)
MOD_KEY=change-me-secret     # gates the /admin dashboard + mod tools. Keep it secret.
RATE_LIMIT=on                # abuse throttles (auto-on in prod; set explicitly to be sure)
TRUST_PROXY=on               # set ON when behind a load balancer/proxy (Render, Railway, Fly all are)

# ── OPTIONAL (game) ──
INVITE_MODE=on               # closed alpha: players need an invite code (mint them from /admin)
PUBLIC_URL=https://your-domain.com        # your live URL (share links, OG cards, OpenAPI base)
SOCIAL_GAME_URL=https://your-domain.com   # the URL put in share/brag links
SOCIAL_X_HANDLE=OmertaOnRH               # the @handle in share links (no @)
INVARIANT_WEBHOOK_URL=       # a Slack/Discord webhook — get pinged if the economy ever drifts (recommended)
PG_POOL_MAX=20               # DB connection pool size (raise with traffic)
REDIS_URL=                   # only needed if you run MORE THAN ONE api instance (shared rate-limit buckets)
# PRIVY_APP_ID=              # enables Privy sign-in (else guest + X only)
# WALLETCONNECT_PROJECT_ID=  # mobile wallet linking (a PUBLIC WalletConnect/Reown project id — not a secret).
                             # Desktop browser wallets are auto-discovered (EIP-6963) and need nothing here.
                             # A PHONE browser has no wallet extension, so without this a mobile player cannot
                             # link a wallet at all. Free id: https://dashboard.reown.com → Create Project.

# ── CHAIN / MAINNET — LEAVE ALL OF THESE UNSET FOR THE GAME (WAVE 1) ──
# Setting these activates the real-money rail. Do NOT until CHAIN-DEPLOY.md's gates are met (forge test,
# a contract+signer audit, and your legal boundaries). See CHAIN-DEPLOY.md §4 for the full table.
# CHAIN_RPC_URL=
# CHAIN_ID=
# CHAIN_START_BLOCK=
# CHAIN_CONFIRMATIONS=5
# VOUCHER_CLAIM_ADDRESS=
# VOUCHER_SIGNER_PK=          # the crown-jewel signing key — belongs in an HSM/KMS, never a plain env var
# OMERTA_FEES_ADDRESS=
# OMERTA_BOND_ADDRESS=
# DAILY_CAP_OMR=
# MINT_FEE_ETH=
# RESPAWN_FEE_ETH=

# ── NEVER set in production (the boot guard rejects them — they turn money rolls into always-win switches) ──
# SEARCH_MS, SHOOT_CD_MS, LAW_BUST_P, SHANK_P, PEN_BREAK_P, WORLD_RAID_P, PORT_INTERDICT_P, *_MS window knobs …
# ALLOW_MOD_REAL_REVENUE  ← QA-only; never in production.
