# DATABASE_URL=postgres://user:pass@localhost:5432/omerta   # omit to use in-memory pg-mem
# JWT_SECRET=change-me-in-production
# PORT=8787
# MARKET_SEED=rotate-per-season-server-secret   # §7.11: keeps future price blocks unpredictable
# MOD_KEY=long-random-string                    # enables /v1/mod/* (X-Mod-Key header); unset = mod tools off
# SOCIAL_VERIFY_MODE=off                        # off | trust (alpha honor system) | live (real API checks)
# X_BEARER_TOKEN= X_TARGET_USER_ID=             # SOCIAL_VERIFY_MODE=live: X follow check
# DISCORD_BOT_TOKEN= DISCORD_GUILD_ID=          # SOCIAL_VERIFY_MODE=live: Discord member check
# SEARCH_MS / SHOOT_CD_MS / (never set in production — test-only §9 timer shrink)
# RATE_LIMIT=on                                 # §10.2; auto-on when NODE_ENV=production
# REDIS_URL=redis://localhost:6379              # shared rate-limit buckets across processes
# INVITE_MODE=on                                # closed alpha: new accounts need an invite code
# PRIVY_APP_ID=                                 # enables POST /v1/auth/privy
# INVARIANT_WEBHOOK_URL=                        # §10.4 drift alerts POST here (plus telemetry always)
# ── M6-B chain service (Robinhood Chain / EVM — see omerta-chain-migration-evm.md) ──
# VOUCHER_SIGNER_PK=                            # server key that signs EIP-712 vouchers (viem); unset = withdrawals disabled
# VOUCHER_CLAIM_ADDRESS=                        # deployed VoucherClaim contract (EIP-712 verifyingContract)
# CHAIN_ID=46630                                # Robinhood Chain testnet (mainnet 4663) — signer derives the domain from this
# CHAIN_RPC_URL=                                # set (with VOUCHER_CLAIM_ADDRESS) to run the Claimed watcher in the worker
# ── §11 entry/revive fees (paid on-chain to OmertaFees → forwarded to the dev wallet) ──
# OMERTA_FEES_ADDRESS=                          # deployed OmertaFees contract; set (with CHAIN_RPC_URL) to run the fee watcher
# DEV_WALLET=                                   # fee recipient (deploy-time; the contract forwards every fee here)
# MINT_FEE_WEI=10000000000000000               # 0.01 ETH — make a free character permanent (two-tier gate)
# RESPAWN_FEE_WEI=100000000000000000           # 0.10 ETH — one pre-paid revive (absorbs a killing blow)
# CHAIN_START_BLOCK=                            # contracts' deploy block — the watcher backfills from here (avoids a genesis scan)
# CHAIN_CONFIRMATIONS=5                         # blocks behind head the event sync stays (reorg safety)
# CHAIN_POLL_MS=30000                           # how often the worker polls getLogs for fee/Claimed events
