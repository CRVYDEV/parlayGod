# ══════════════════════════════════════════════════════════════════════════════════════════════════
# PATH A — the founder-signed revenue configuration (deploy/fee-splits.json, 2026-08-13).
#
# GO-LIVE CONFIG. These are the backend levers that translate the signed fee split into what the
# ingests book. They are DORMANT until the chain goes live (past the launch-checklist + audit gate):
# nothing here moves real ETH while CHAIN_ID is unset and no contracts are deployed, because the
# ingests (recordFeePayment / recordStorePurchase / recordSellTax / recordHarvestFee / POL fees) only
# fire from the on-chain watcher. So do NOT paste this into the live render.yaml yet — it is applied
# as part of the chain go-live deploy, on BOTH the api and the worker service, alongside the matching
# CONTRACT ARGS below (which must be set in lockstep, or the backend books a split the chain doesn't).
#
# Validate before every deploy:  node tools/validate-fee-splits.js
# (loads the router with exactly these values and asserts they reproduce fee-splits.json, and that
#  every load guard accepts them.)
#
# The code DEFAULTS stay byte-identical (community slices 0) so the dormant baseline is unchanged and
# test/community.js block 1's byte-identity holds — this file IS the "env flip with sign-off"
# (omerta-treasury-to-family-design.md §8 Phase 2).
# ══════════════════════════════════════════════════════════════════════════════════════════════════

# ── fee: vig 2500 / treasury 1000 / community 1500 / operations 5000 ──
#   vig 6000→2500 is ALSO OmertaFees.vigBps (immutable ctor arg — set to 2500 at deploy, lockstep).
VIG_BPS=2500
FEE_RWA_BPS=1000            # treasury (unchanged default; set explicit for the record)
FEE_COMMUNITY_BPS=1500

# ── store: vig 2500 / treasury 1000 / community 1500 / operations 5000 (all backend; StorePaid unbuilt) ──
REVENUE_BUYBACK_BPS=2500    # store "vig"
REVENUE_RWA_BPS=1000        # store "treasury"
REVENUE_FOUNDER_BPS=6500    # store "operations" gross (operations net = 6500 − 1500 community = 5000)
STORE_COMMUNITY_BPS=1500

# ── bond: pol 7500 / vig 500 / treasury 500 / operations 1500 ──
#   pol/dev/rwa are ALSO OmertaBond immutable ctor args (polBps 7500, devBps 1500, rwaBps 500); vig
#   is the on-chain remainder = 500. Set the contract args in lockstep at deploy.
BOND_POL_BPS=7500
BOND_VIG_BPS=500
BOND_RWA_BPS=500
BOND_DEV_BPS=1500          # unchanged

# ── tax (of the 900-bps sell tax): dev 200 / rwa 160 / community 240 / lp 300 (of-trade; sum 900) ──
#   The four-way rules.tail.js load guard REQUIRES rwa 400→160 in the SAME deploy as community 0→240.
#   community is a BACKEND carve in recordSellTax (no 4th on-chain recipient). The on-chain sell-tax
#   split (OMR.sol/OmertaHook setSellTax) stays THREE-way dev/rwa/lp = 200/160/remainder.
SELL_TAX_DEV_BPS=200       # unchanged
SELL_TAX_RWA_BPS=160       # was 400
SELL_TAX_LP_BPS=300        # unchanged (remainder rule sits here)
SELL_TAX_COMMUNITY_BPS=240

# ── harvest (of the 2000-bps Bank fee): treasury 3720 / community 6280 (in the market's underlying) ──
#   The harvest carve comes out of bank_revenue, which is ALSO the city-leg budget — a real cut to a
#   shipped payout (BALANCE § THE FAMILY BUYBACK). Signed as part of Path A.
HARVEST_COMMUNITY_BPS=6280

# ── polfees: desk-buyback 7500 / vig 2500 (POL trading fees diverted to the reserve) ──
POL_FEES_VIG_BPS=2500

# ── auction (pol 5000 / operations 5000) and toll (dev 5000 / community 5000): UNCHANGED from the
#    code defaults (DESK_AUCTION.ETH_POL_BPS 5000, TAX.DEV_BPS 5000) — no env needed.
# ── trade: RETIRED (historical vig only) — no env.
